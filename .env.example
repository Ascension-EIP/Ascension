# =============================================================================
# Services
# =============================================================================

## PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ascension
POSTGRES_PASSWORD=ascension
POSTGRES_DB=ascension
POSTGRES_PARAMS="sslmode=disable"
POSTGRES_MIGRATION=true
POSTGRES_DB_URL=postgres://ascension:ascension@localhost:5432/ascension

## Object storage (RustFS in development, OVHcloud Object Storage in production)
### Go server
STORAGE_ENDPOINT=http://localhost:9000
### Signing region: any value for RustFS, "gra" for OVHcloud Object Storage (Gravelines)
STORAGE_REGION=us-east-1
STORAGE_BUCKET=videos
STORAGE_ID=ascension
STORAGE_SECRET=ascension
STORAGE_UPLOAD_EXP=1h
STORAGE_DOWNLAOD_EXP=1h
### AI worker
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=ascension
RUSTFS_SECRET_KEY=ascension
RUSTFS_BUCKET=videos
RUSTFS_REGION=us-east-1
### RustFS container of docker-compose.yml (host port and root credentials)
MINIO_PORT=9000
MINIO_ID=ascension
MINIO_SECRET=ascension

## RabbitMQ
### Go server
QUEUE_HOST=localhost
QUEUE_PORT=5672
QUEUE_USER=ascension
QUEUE_PASS=ascension
QUEUE_TLS=false
QUEUE_EXCHANGE_EVENT=events
### AI worker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ascension
RABBITMQ_PASS=ascension
### RabbitMQ container of docker-compose.yml
RABBITMQ_DEFAULT_USER=ascension
RABBITMQ_DEFAULT_PASS=ascension

## SonarQube
SONAR_HOST_URL=http://localhost:9005
SONAR_ADMIN_PASSWORD=AscensionSonarSecret2026!
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar_pass_123!
SONAR_DB_NAME=sonar
SONAR_TOKEN=your_sonar_token_here



# =============================================================================
# Apps
# =============================================================================

## AI
PYTHONUNBUFFERED=1
### LLM (any OpenAI-compatible endpoint: change these three variables to change model)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.1-flash-lite
### Read by .github/scripts (commit/PR review tooling), not by the AI worker
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

## Backend
PORT=8080
HTTPS=false

### Auth / JWT
AUTH_JWT_SECRET=your_jwt_secret_key_here
AUTH_JWT_EXP=15m
AUTH_SESSION_SECRET=user_session
AUTH_SESSION_EXP=168h
AUTH_SESSION_REMEMBER_EXP=720h

### Logs
LOG_LEVEL=info
LOG_PRETTY=false

## Mobile
BACKEND_URL=http://localhost:8080
