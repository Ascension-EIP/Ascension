# =============================================================================
# Apps
# =============================================================================

## AI
PYTHONUNBUFFERED=1
GEMINI_API_KEY=your_gemini_api_key_here

## Backend
PORT=8080
HTTPS=false

### Auth / JWT
AUTH_JWT_SECRET=your_jwt_secret_key_here
AUTH_JWT_EXP=15m
AUTH_SESSION_SECRET=user_session
AUTH_SESSION_EXP=168h
AUTH_SESSION_REMEMBER_EXP=720h

### Logs
LOG_LEVEL=info
LOG_PRETTY=false

## Mobile
BACKEND_URL=http://localhost:8080
