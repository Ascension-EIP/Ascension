# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union

# Exclude generated/boilerplate languages from GitHub statistics (Dart/Flutter boilerplate)
*.cpp linguist-detectable=false
*.h linguist-detectable=false
*.cc linguist-detectable=false
*.cxx linguist-detectable=false
*.hpp linguist-detectable=false
CMakeLists.txt linguist-detectable=false
*.cmake linguist-detectable=false
*.rb linguist-detectable=false
Podfile linguist-detectable=false
Podfile.lock linguist-detectable=false
Gemfile linguist-detectable=false
Gemfile.lock linguist-detectable=false
