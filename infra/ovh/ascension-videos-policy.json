{
  "Statement": [
    {
      "Sid": "AscensionVideosBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": ["arn:aws:s3:::ascension-videos"]
    },
    {
      "Sid": "AscensionVideosObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": ["arn:aws:s3:::ascension-videos/*"]
    },
    {
      "Sid": "DenyAccountActions",
      "Effect": "Deny",
      "Action": ["s3:ListAllMyBuckets", "s3:CreateBucket"],
      "Resource": ["*"]
    },
    {
      "Sid": "DenyBucketAdministration",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:PutBucketAcl",
        "s3:PutBucketCORS",
        "s3:PutBucketLogging",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketTagging",
        "s3:DeleteBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutBucketWebsite",
        "s3:DeleteBucketWebsite",
        "s3:PutEncryptionConfiguration",
        "s3:PutIntelligentTieringConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": ["arn:aws:s3:::ascension-videos"]
    },
    {
      "Sid": "DenyObjectAdministration",
      "Effect": "Deny",
      "Action": [
        "s3:PutObjectAcl",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": ["arn:aws:s3:::ascension-videos/*"]
    }
  ]
}
