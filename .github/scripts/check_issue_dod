#!/usr/bin/env python3
"""
Script validating Definition of Done (DoD) upon issue closure.
Reopens the issue and leaves a comment mentioning the closer if:
- Definition of Done checkboxes are present and not all are checked.
If no Definition of Done is defined, validation succeeds.
"""

import json
import os
import re
import sys
import urllib.error
import urllib.request


is_github_actions = os.environ.get("GITHUB_ACTIONS") == "true"


def log_notice(msg: str):
    prefix = "::notice::" if is_github_actions else ""
    print(f"{prefix}{msg}")


def log_warning(msg: str):
    prefix = "::warning::" if is_github_actions else ""
    print(f"{prefix}{msg}")


def log_error(msg: str):
    prefix = "::error::" if is_github_actions else ""
    print(f"{prefix}{msg}")


def send_api_request(url: str, method: str = "GET", data: dict = None, token: str = None) -> tuple[int, dict]:
    headers = {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "Ascension-Issue-DoD-Checker",
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"

    encoded_data = json.dumps(data).encode("utf-8") if data is not None else None
    if encoded_data:
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=encoded_data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req) as resp:
            content = resp.read().decode("utf-8")
            return resp.status, json.loads(content) if content else {}
    except urllib.error.HTTPError as err:
        err_body = err.read().decode("utf-8")
        try:
            parsed = json.loads(err_body)
        except Exception:
            parsed = {"raw": err_body}
        return err.code, parsed


def extract_dod_section(body: str) -> tuple[bool, str]:
    if not body:
        return False, ""

    # Look for a section titled Definition(s) of Done or DoD
    # Matches markdown headings (##, ###), bold (**Definition of Done**), or plain labels
    pattern = re.compile(
        r'(?i)(?:^|\n)\s*(?:#{1,6}\s*|\*{1,2}\s*)?(?:[0-9.]+\s*)?(?:definitions?\s+of\s+done|dod)\b[^\n]*\n(.*)',
        re.DOTALL
    )
    match = pattern.search(body)
    if not match:
        return False, ""

    section_body = match.group(1)
    # Stop at the next markdown section header
    next_header = re.search(r'\n\s*#{1,6}\s+[^\n]+', section_body)
    if next_header:
        section_body = section_body[:next_header.start()]

    return True, section_body


def reopen_issue(token: str, repo: str, issue_number: int):
    url = f"https://api.github.com/repos/{repo}/issues/{issue_number}"
    status, res = send_api_request(url, method="PATCH", data={"state": "open"}, token=token)
    if status in (200, 201):
        log_notice(f"Issue #{issue_number} successfully reopened.")
    else:
        log_error(f"Failed to reopen issue #{issue_number} (HTTP {status}): {res}")


def post_comment(token: str, repo: str, issue_number: int, comment: str):
    url = f"https://api.github.com/repos/{repo}/issues/{issue_number}/comments"
    status, res = send_api_request(url, method="POST", data={"body": comment}, token=token)
    if status in (200, 201):
        log_notice(f"Comment successfully posted on issue #{issue_number}.")
    else:
        log_error(f"Failed to post comment on issue #{issue_number} (HTTP {status}): {res}")


def main():
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if not token:
        log_error("Missing GITHUB_TOKEN or GH_TOKEN environment variable.")
        sys.exit(1)

    event_path = os.environ.get("GITHUB_EVENT_PATH")
    if not event_path or not os.path.exists(event_path):
        log_error("GITHUB_EVENT_PATH is not set or file does not exist.")
        sys.exit(1)

    with open(event_path, "r", encoding="utf-8") as f:
        event = json.load(f)

    repo = event.get("repository", {}).get("full_name")
    issue = event.get("issue")
    if not issue or not repo:
        log_error("Missing issue or repository data in GitHub event payload.")
        sys.exit(1)

    issue_number = issue.get("number")
    issue_body = issue.get("body") or ""
    closer = (
        event.get("sender", {}).get("login")
        or issue.get("closed_by", {}).get("login")
        or "contributeur"
    )

    log_notice(f"Checking Definition of Done for closed issue #{issue_number} by @{closer}")

    has_section, section_text = extract_dod_section(issue_body)
    checkbox_pattern = re.compile(r'^\s*[-*+]\s+\[([ xX])\]\s*(.+)$', re.MULTILINE)
    items = checkbox_pattern.findall(section_text) if has_section else []

    # Case 1: No Definition of Done section or no checkboxes inside DoD section -> Allowed
    if not has_section or len(items) == 0:
        log_notice(f"No Definition of Done defined on issue #{issue_number} — validation passed.")
        sys.exit(0)

    # Check for unchecked items
    total = len(items)
    checked_count = sum(1 for status, _ in items if status.lower() == 'x')
    unchecked_items = [text.strip() for status, text in items if status.strip() == '']

    # Case 2: Some Definition of Done checkboxes are not completed
    if unchecked_items:
        log_warning(
            f"Issue #{issue_number} closed with incomplete Definition of Done "
            f"({len(unchecked_items)}/{total} unchecked)."
        )
        bullet_list = "\n".join(f"- [ ] {item}" for item in unchecked_items)
        comment = (
            f"Bonjour @{closer},\n\n"
            "Cette issue a été **réouverte automatiquement**.\n\n"
            "⚠️ **Toutes les Definitions of Done ne sont pas validées.**\n\n"
            "Il est strictement interdit de fermer une issue tant que toutes ses Definitions of Done ne sont pas terminées.\n\n"
            "Merci de :\n"
            "1. **Vérifier** si toutes les Definitions of Done ont été faites et cocher les cases correspondantes (`- [x]`).\n"
            "2. **Ou au besoin redéfinir** la liste des Definitions of Done si certains critères ont évolué, ne sont plus pertinents ou ont été déplacés dans une autre issue.\n\n"
            f"### 📋 Tâches restantes non complétées ({len(unchecked_items)}/{total}) :\n"
            f"{bullet_list}"
        )
        reopen_issue(token, repo, issue_number)
        post_comment(token, repo, issue_number, comment)
        sys.exit(1)

    # Case 3: All items are checked
    log_notice(f"All {total} Definition of Done criteria are validated on issue #{issue_number}.")
    sys.exit(0)


if __name__ == "__main__":
    main()
